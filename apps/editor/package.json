{
	"name": "editor",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"predev": "npm --prefix ../.. run build -w @shadertoy/compiler -w @shadertoy/runner",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^25.5.2",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@shadertoy/compiler": "file:../../packages/compiler",
		"@shadertoy/runner": "file:../../packages/runner",
		"@xyflow/svelte": "^1.5.2",
		"dockview-core": "^5.2.0"
	}
}
